{
  "name": "gdex",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "trustedDependencies": [
    "fallow"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "simple-git-hooks",
    "comment-fmt:check": "comment-fmt --check",
    "format": "biome check --write",
    "fmt:check": "biome format .",
    "lint": "biome lint",
    "lint:ci": "biome ci --formatter-enabled=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check"
  },
  "dependencies": {
    "@preact/signals": "^2.9.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.2",
    "@tauri-apps/plugin-fs": "~2.5.1",
    "@tauri-apps/plugin-store": "~2.4.4",
    "@vanilla-extract/css": "^1.21.1",
    "preact": "^10.29.7",
    "tinykeys": "^4.0.0",
    "ts-dedent": "^2.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.11.4",
    "@vanilla-extract/vite-plugin": "^5.2.5",
    "comment-fmt": "^0.1.8",
    "fallow": "3.7.1",
    "lint-staged": "^17.2.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched",
      "comment-fmt --write"
    ]
  }
}
